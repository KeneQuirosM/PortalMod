<configs>
  <!--
      recipes.xml — PortalMod
      Receta de portalBlockItem, crafteable unicamente en workbench.
  -->
  <append xpath="/recipes">

    <recipe name="portalBlockItem" count="1" craft_area="workbench" craft_tool="toolCraftWorkbenchAdvanced" tags="craftingFromWorkbenchOnly">
      <ingredient name="resourceScrapIron" count="1500" />
      <ingredient name="resourceForgedIron" count="450" />
      <ingredient name="resourceElectricParts" count="125" />
      <ingredient name="resourceDuctTape" count="20" />
      <property name="craft_time" value="60" />
    </recipe>

  </append>
</configs>
