<configs>
  <!--
      buffs.xml — PortalMod
      buffPortalTravel: aplicado al jugador justo DESPUES de teletransportarlo
      (ver PortalTeleport.ExecuteTeleport), es decir con el jugador ya parado
      en el portal de DESTINO. Congela el movimiento durante la transicion
      (2s) y dispara los efectos de "llegada": flash + particulas + sonido.

      El efecto del portal de ORIGEN (donde ya no queda ningun jugador al que
      atarle un buff) se dispara aparte, directamente desde C#, ver
      PortalVisualFX.SpawnTeleportBurst() llamado en PortalTeleport.cs antes
      Y despues del teletransporte (origen y destino respectivamente), como
      refuerzo adicional a lo que ya hace este buff en el jugador.

      ASSETS (CONFIRMADO contra el XML original del mod de assets SCore):
        - gupFuturePortal4.unity3d (prefab guppyFuturePortal4.prefab) como
          flash/destello de teletransporte al llegar.
        - El sonido de activacion NO se referencia directo por ruta de
          AssetBundle: los <triggered_effect action="PlaySound"> requieren un
          nombre de sonido REGISTRADO previamente. Se registro
          "guppyKeyUsed" en Config/sounds.xml, que apunta internamente al
          clip "guppyKeyCardSound" dentro de gupKeyCardSound.unity3d — aqui
          simplemente se referencia sound="guppyKeyUsed".
        - gupTeleportRide.unity3d (prefab guppyTeleportRide) como efecto de
          viaje: NO es una particula en loop sino un prefab que se adjunta a
          la camara del jugador mientras dura el buff, via
          action="AttachPrefabToEntity" / parent_transform="CameraNode", y se
          quita explicitamente al terminar via action="RemovePrefabFromEntity".
  -->
  <append xpath="/buffs">

    <buff name="buffPortalTravel" name_key="buffPortalTravelName" tooltip_key="buffPortalTravelDesc"
          icon="ui_game_symbol_stun" iconColor="120,200,255" hidden="false"
          duration="2" DebuffPlayer="false">

      <!-- Congela al jugador: velocidad de movimiento a 0 durante toda la duracion -->
      <effect_group name="Portal Freeze">
        <passive_effect name="ModifyMoveSpeed" operation="perc_set" value="0" />
        <passive_effect name="ModifyRunSpeed" operation="perc_set" value="0" />
        <passive_effect name="JumpModifier" operation="perc_set" value="0" />
      </effect_group>

      <!--
          LLEGADA (justo al aplicarse el buff, con el jugador ya en el
          destino): destello/particula de teletransporte (gupFuturePortal4)
          + sonido de activacion (guppyKeyUsed, registrado en sounds.xml).
          particle_scale elevado a proposito para "potenciar" el efecto de
          salida pedido. Tambien adjunta el prefab de "viaje"
          (guppyTeleportRide) a la camara del jugador — ver bloque de abajo.
      -->
      <triggered_effect trigger="onSelfBuffStart" action="PlayParticleEffect" particle="#@modfolder:Resources/gupFuturePortal4.unity3d?guppyFuturePortal4.prefab" particle_scale="1.6" />
      <triggered_effect trigger="onSelfBuffStart" action="PlaySound" sound="guppyKeyUsed" />

      <!--
          DURANTE la transicion (2s): prefab de "viaje" (guppyTeleportRide)
          adjunto a la camara del jugador (parent_transform="CameraNode"),
          no una particula en loop — asi es como lo usa el mod de assets
          original. Se retira explicitamente al terminar el buff (ver
          onSelfBuffRemove abajo); duration=2 en el <buff> ya limita cuanto
          dura pegado a la camara aun si algo fallara al remover el prefab.
      -->
      <triggered_effect trigger="onSelfBuffStart" action="AttachPrefabToEntity" prefab="#@modfolder:Resources/gupTeleportRide.unity3d?guppyTeleportRide" parent_transform="CameraNode" local_offset="0,0,-1" local_rotation="0,180,0" />

      <!-- Al finalizar (expira a los 2s, restaura velocidad automaticamente): quitar el prefab de viaje de la camara -->
      <triggered_effect trigger="onSelfBuffRemove" action="RemovePrefabFromEntity" prefab="guppyTeleportRide" />

    </buff>

  </append>
</configs>
